    <!-- ── SCRIPTS ── -->
    <script>
      import gsap from 'gsap';
      import { SplitText } from 'gsap/SplitText';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(SplitText, ScrollTrigger);

      // ── Nav: transparent → solid on scroll ──
      const navEl = document.querySelector('nav');
      if (navEl) {
        ScrollTrigger.create({
          start: 'top -80',
          onUpdate: (self) => {
            if (self.direction === 1 && window.scrollY > 80) {
              navEl.classList.add('nav-solid');
            } else if (window.scrollY <= 80) {
              navEl.classList.remove('nav-solid');
            }
          },
        });
      }

      // ── Mobile menu toggle ──
      const menuToggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      menuToggle?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
      // Close mobile menu on link click
      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
      });

      // ── Hero h1: word-by-word slide up (no opacity — always readable) ──
      const h1El = document.querySelector('h1');
      if (h1El) {
        const split = new SplitText(h1El, { type: 'words', wordsClass: 'word-clip' });
        gsap.from(split.words, {
          y: '100%',
          duration: 0.55,
          stagger: 0.09,
          ease: 'power3.out',
          delay: 0.15,
        });
      }

      // ── Hero above-fold stagger (transform only — no opacity) ──
      const heroEls = document.querySelectorAll<HTMLElement>('.hero-reveal');
      gsap.from([...heroEls].slice(2), {
        y: 20,
        duration: 0.6,
        stagger: 0.12,
        ease: 'power2.out',
        delay: 0.5,
      });

      // ── Scroll reveals — transform only, no opacity (content always readable) ──
      ScrollTrigger.batch('.reveal', {
        onEnter: (batch) => gsap.from(batch, {
          y: 32,
          duration: 0.7,
          stagger: 0.08,
          ease: 'power2.out',
        }),
        start: 'top 85%',
        once: true,
      });

      // ── Hero phone parallax ──
      const heroSection = document.querySelector('.hero');
      if (heroSection) {
        gsap.to('.phone-float', {
          y: -60,
          ease: 'none',
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: 0.8,
          },
        });
      }

      // ── Animated counters (problem section + pricing) ──
      // HTML already shows final values as fallback; animate only when scrolled into view
      document.querySelectorAll('.counter, .counter-price').forEach(el => {
        const target = parseInt((el as HTMLElement).dataset.target || '0', 10);
        const prefix = (el as HTMLElement).dataset.prefix || '';
        const duration = el.classList.contains('counter-price') ? 1.2 : 1.5;
        let animated = false;
        ScrollTrigger.create({
          trigger: el,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            if (animated) return;
            animated = true;
            const obj = { val: 0 };
            gsap.to(obj, {
              val: target,
              duration,
              ease: 'power2.out',
              onUpdate() {
                (el as HTMLElement).textContent = prefix + Math.round(obj.val).toLocaleString('en-IN');
              },
            });
          },
        });
      });

      // ── Feature card hover — icon GSAP pop ──
      document.querySelectorAll('.feature-card').forEach(card => {
        const icon = card.querySelector('svg');
        if (!icon) return;
        card.addEventListener('mouseenter', () => {
          gsap.to(icon, { scale: 1.15, duration: 0.25, ease: 'back.out(2)' });
        });
        card.addEventListener('mouseleave', () => {
          gsap.to(icon, { scale: 1, duration: 0.2, ease: 'power2.out' });
        });
      });

      // ── FAQ accordion ──
      document.querySelectorAll('.faq-item').forEach(item => {
        const btn = item.querySelector('.faq-question');
        const answer = item.querySelector('.faq-answer') as HTMLElement | null;
        const icon = item.querySelector('.faq-icon');
        if (!btn || !answer) return;

        // Set initial closed state
        gsap.set(answer, { height: 0 });

        btn.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');
          if (isOpen) {
            gsap.to(answer, { height: 0, duration: 0.3, ease: 'power2.inOut' });
            if (icon) gsap.to(icon, { rotation: 0, duration: 0.3 });
            item.classList.remove('open');
          } else {
            // Measure natural height
            gsap.set(answer, { height: 'auto' });
            const naturalHeight = answer.offsetHeight;
            gsap.from(answer, { height: 0, duration: 0.3, ease: 'power2.inOut' });
            if (icon) gsap.to(icon, { rotation: 45, duration: 0.3 });
            item.classList.add('open');
          }
        });
      });

      // ── Screenshot: hide fallback if real image loads, otherwise hide broken img ──
      const heroImg = document.getElementById('hero-screenshot') as HTMLImageElement | null;
      const heroFallback = document.getElementById('hero-fallback');
      if (heroImg) {
        heroImg.addEventListener('load', () => {
          heroFallback?.classList.add('hidden');
        });
        heroImg.addEventListener('error', () => {
          heroImg.style.display = 'none';
        });
        // If already loaded (cached)
        if (heroImg.complete && heroImg.naturalWidth > 0) {
          heroFallback?.classList.add('hidden');
        }
      }

      // ── Waitlist form ──
      const SUPABASE_URL = 'https://spldnbrqbuhmlgvwhahj.supabase.co';
      const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

      const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
      const successEl = document.getElementById('waitlist-success');
      const errorEl = document.getElementById('waitlist-error');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const payload = {
          name: data.get('name'),
          email: data.get('email'),
          phone: data.get('phone') || null,
        };

        // Hide previous error
        if (errorEl) { errorEl.classList.add('hidden'); errorEl.textContent = ''; }

        // If no Supabase key configured, show success anyway (graceful degradation)
        if (!SUPABASE_ANON_KEY) {
          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
          return;
        }

        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'apikey': SUPABASE_ANON_KEY,
              'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
              'Prefer': 'return=minimal',
            },
            body: JSON.stringify(payload),
          });

          if (!res.ok) throw new Error('submission failed');

          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
        } catch {
          if (errorEl) {
            errorEl.textContent = 'something went wrong. please try again.';
            errorEl.classList.remove('hidden');
          }
        }
      });
    </script>

  </body>
</html>
