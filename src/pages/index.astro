---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>gymbo — gym management app for personal trainers</title>
    <meta name="description" content="gymbo helps independent personal trainers manage clients, track sessions, handle payments, and grow their business — all in one app." />
    <!-- Open Graph -->
    <meta property="og:title" content="gymbo — gym management app for personal trainers" />
    <meta property="og:description" content="gymbo helps independent personal trainers manage clients, track sessions, handle payments, and grow their business — now on ios." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://getgymbo.com" />
    <meta property="og:image" content="https://getgymbo.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gymbo app — today's sessions, client balances, and earnings at a glance" />
    <meta property="og:site_name" content="Gymbo" />
    <meta property="og:locale" content="en_IN" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="gymbo — gym management app for personal trainers" />
    <meta name="twitter:description" content="gymbo helps independent personal trainers manage clients, track sessions, handle payments, and grow their business — now on ios." />
    <meta name="twitter:image" content="https://getgymbo.com/og-image.png" />
    <meta name="theme-color" content="#f8623a" />
    <meta name="author" content="Gymbo" />
    <!-- Font preconnect + load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" />
    <link rel="canonical" href="https://getgymbo.com" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Gymbo",
        "url": "https://getgymbo.com",
        "logo": "https://getgymbo.com/favicon.svg",
        "description": "Fitness management platform for independent personal trainers in India.",
        "areaServed": "IN",
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "damini@materiallab.io"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Gymbo",
        "applicationCategory": "HealthApplication",
        "applicationSubCategory": "Fitness Business Management",
        "operatingSystem": "iOS",
        "url": "https://getgymbo.com",
        "description": "Gymbo helps independent personal trainers manage clients, track sessions, handle payments, and grow their business — all in one offline-capable app.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "INR"
        },
        "audience": {
          "@type": "Audience",
          "audienceType": "Independent Personal Trainers"
        }
      }
    ])} />
    <!-- Umami analytics -->
    <script defer src="https://analytics.getgymbo.com/script.js" data-website-id="36b8e820-a50a-44b3-a57b-5ee37f719916"></script>
  </head>
  <body>

    <!-- ── NAV ── -->
    <nav class="fixed top-0 w-full z-50 glassnav">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo-mark.svg" alt="gymbo" class="w-8 h-8" />
          <span class="font-bold tracking-widest text-[#ebebe6]">gymbo</span>
        </a>
        <div class="hidden md:flex gap-6 items-center">
          <a href="#features" class="text-sm tracking-widest text-[#ebebe6]/60 hover:text-[#ebebe6] transition-colors">features</a>
          <a href="#pricing" class="text-sm tracking-widest text-[#ebebe6]/60 hover:text-[#ebebe6] transition-colors">pricing</a>
        </div>
        <a
          href="#waitlist"
          class="hidden md:inline-flex text-sm text-[#f8623a] border border-[#f8623a] rounded-full px-4 py-1.5 hover:bg-[#f8623a] hover:text-[#2d2d2d] transition-colors"
        >
          join the beta
        </a>
        <!-- Mobile hamburger -->
        <button id="menu-toggle" class="md:hidden text-[#ebebe6] p-2" aria-label="toggle menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden px-6 pb-4 flex flex-col gap-4 border-t border-[#ebebe6]/10">
        <a href="#features" class="text-sm tracking-widest text-[#ebebe6]/60 hover:text-[#ebebe6] transition-colors pt-4">features</a>
        <a href="#pricing" class="text-sm tracking-widest text-[#ebebe6]/60 hover:text-[#ebebe6] transition-colors">pricing</a>
        <a href="#waitlist" class="text-sm text-[#f8623a] tracking-widest">join the beta</a>
      </div>
    </nav>

    <!-- ── HERO ── -->
    <section class="hero px-6 pt-32 pb-20 md:pt-40 md:pb-24">
      <div class="max-w-6xl mx-auto w-full">
        <!-- Text block — centered -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="hero-reveal eyebrow text-[#f8623a] mb-4">for independent trainers</div>

          <h1 class="hero-reveal fluid-h1 font-bold tracking-widest mb-6 leading-tight">
            run your training business<br />
            <span class="gradient-text">from one app.</span>
          </h1>

          <p class="hero-reveal text-lg md:text-xl text-[#ebebe6]/80 mb-10 max-w-2xl mx-auto leading-relaxed">
            gymbo replaces whatsapp threads, paper diaries, and payment arguments with a single app. schedule sessions, track payments, manage every client. built for trainers who work on the go.
          </p>

          <div class="hero-reveal flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a
              href="#waitlist"
              class="rounded-full bg-[#f8623a] text-[#2d2d2d] font-bold tracking-widest px-8 py-3 hover:opacity-90 transition-opacity w-full sm:w-auto text-center"
              data-umami-event="cta_join_beta"
            >
              join the beta
            </a>
            <span class="text-xs text-[#ebebe6]/40 tracking-widest border border-[#ebebe6]/20 rounded-full px-4 py-2">
              currently on testflight
            </span>
          </div>

          <a href="#problem" class="hero-reveal inline-block mt-8 text-sm text-[#ebebe6]/50 tracking-widest hover:text-[#f8623a] transition-colors">
            see what's inside ↓
          </a>
        </div>

        <!-- Phone mockup — centered below text -->
        <div class="hero-reveal phone-float flex justify-center relative">
          <div class="w-64 md:w-72 bg-[#242424] rounded-[2.5rem] border border-[#ebebe6]/10 p-2 shadow-2xl">
            <div class="rounded-[2rem] bg-[#1a1a1a] overflow-hidden aspect-[9/19] relative">
              <img
                id="hero-screenshot"
                src="/ios-screen-clients.png"
                alt="gymbo ios app — client list"
                class="w-full h-full object-cover"
              />
              <!-- Branded fallback — visible by default, hidden if real screenshot loads -->
              <div id="hero-fallback" class="absolute inset-0 flex flex-col items-center justify-center bg-[#1a1a1a] px-6">
                <!-- Fake app UI -->
                <div class="w-full">
                  <div class="flex items-center justify-between mb-6">
                    <img src="/logo-mark.svg" alt="gymbo" class="w-6 h-6" />
                    <div class="text-[9px] text-[#ebebe6]/30 tracking-widest">gymbo</div>
                    <div class="w-6 h-6 rounded-full bg-[#ebebe6]/10"></div>
                  </div>
                  <div class="text-[10px] text-[#ebebe6]/40 tracking-widest mb-3">your clients</div>
                  <!-- Fake client rows -->
                  <div class="space-y-2">
                    <div class="flex items-center gap-3 bg-[#242424] rounded-xl p-3">
                      <div class="w-8 h-8 rounded-full bg-[#f8623a]/20 flex items-center justify-center text-[10px] text-[#f8623a] font-bold">s</div>
                      <div class="flex-1">
                        <div class="text-[10px] text-[#ebebe6]/80 font-bold tracking-wide">sarfaraz</div>
                        <div class="text-[8px] text-[#ebebe6]/30 tracking-wide">4 sessions left</div>
                      </div>
                      <div class="text-[9px] text-[#4ADE80] font-bold">₹0</div>
                    </div>
                    <div class="flex items-center gap-3 bg-[#242424] rounded-xl p-3">
                      <div class="w-8 h-8 rounded-full bg-[#f8623a]/20 flex items-center justify-center text-[10px] text-[#f8623a] font-bold">p</div>
                      <div class="flex-1">
                        <div class="text-[10px] text-[#ebebe6]/80 font-bold tracking-wide">priya</div>
                        <div class="text-[8px] text-[#ebebe6]/30 tracking-wide">7 sessions left</div>
                      </div>
                      <div class="text-[9px] text-[#f8623a] font-bold">₹1,200</div>
                    </div>
                    <div class="flex items-center gap-3 bg-[#242424] rounded-xl p-3">
                      <div class="w-8 h-8 rounded-full bg-[#f8623a]/20 flex items-center justify-center text-[10px] text-[#f8623a] font-bold">a</div>
                      <div class="flex-1">
                        <div class="text-[10px] text-[#ebebe6]/80 font-bold tracking-wide">aditya</div>
                        <div class="text-[8px] text-[#ebebe6]/30 tracking-wide">12 sessions left</div>
                      </div>
                      <div class="text-[9px] text-[#4ADE80] font-bold">₹0</div>
                    </div>
                    <div class="flex items-center gap-3 bg-[#242424] rounded-xl p-3">
                      <div class="w-8 h-8 rounded-full bg-[#f8623a]/20 flex items-center justify-center text-[10px] text-[#f8623a] font-bold">r</div>
                      <div class="flex-1">
                        <div class="text-[10px] text-[#ebebe6]/80 font-bold tracking-wide">rakesh</div>
                        <div class="text-[8px] text-[#ebebe6]/30 tracking-wide">1 session left</div>
                      </div>
                      <div class="text-[9px] text-[#d4183d] font-bold">₹2,400</div>
                    </div>
                  </div>
                  <!-- Bottom nav hint -->
                  <div class="flex justify-around mt-6 pt-3 border-t border-[#ebebe6]/10">
                    <div class="w-1.5 h-1.5 rounded-full bg-[#f8623a]"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#ebebe6]/20"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#ebebe6]/20"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#ebebe6]/20"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute inset-0 -z-10 blur-3xl opacity-20 bg-[#f8623a] rounded-full scale-75"></div>
        </div>
      </div>
    </section>

    <!-- ── THE PROBLEM ── -->
    <section id="problem" class="py-24 px-6 border-t border-[#ebebe6]/10">
      <div class="max-w-4xl mx-auto">
        <div class="reveal eyebrow text-[#f8623a] mb-4 text-center">the problem</div>
        <h2 class="reveal fluid-h1 font-bold tracking-widest text-center mb-6 leading-tight">
          whatsapp works<br />
          <span class="gradient-text">until it doesn't.</span>
        </h2>
        <p class="reveal text-lg text-[#ebebe6]/80 text-center max-w-2xl mx-auto mb-16 leading-relaxed">
          you started with 5 clients and a notebook. now you have 18. sessions overlap. payments slip through. a client messages at 11pm asking for tomorrow's workout. you scroll past 47 whatsapp chats to find who owes what.
        </p>

        <!-- Stat callouts -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-16">
          <div class="reveal text-center p-6 bg-[#242424] border border-[#ebebe6]/10 rounded-2xl">
            <div class="text-4xl font-bold text-[#f8623a] mb-2 counter" data-target="15" data-prefix="~">~15</div>
            <div class="text-sm text-[#ebebe6]/50 tracking-wide">clients — where the system breaks</div>
          </div>
          <div class="reveal text-center p-6 bg-[#242424] border border-[#ebebe6]/10 rounded-2xl">
            <div class="text-4xl font-bold text-[#f8623a] mb-2">5-10</div>
            <div class="text-sm text-[#ebebe6]/50 tracking-wide">hrs/week on scheduling, billing, tracking</div>
          </div>
          <div class="reveal text-center p-6 bg-[#242424] border border-[#ebebe6]/10 rounded-2xl">
            <div class="text-4xl font-bold text-[#f8623a] mb-2 counter" data-target="1500" data-prefix="₹">₹1,500</div>
            <div class="text-sm text-[#ebebe6]/50 tracking-wide">per missed or double-booked session</div>
          </div>
        </div>

        <p class="reveal text-center text-[#ebebe6]/40 text-sm tracking-wide max-w-xl mx-auto">
          every trainer who goes independent hits this wall. the tools were never built for you.
        </p>
      </div>
    </section>

    <!-- ── FEATURES ── -->
    <section id="features" class="py-24 px-6 border-t border-[#ebebe6]/10">
      <div class="max-w-6xl mx-auto">
        <div class="reveal eyebrow text-[#f8623a] mb-4 text-center">what gymbo does</div>
        <h2 class="reveal fluid-h2 font-bold tracking-widest text-center mb-4">
          six things that pay for themselves.
        </h2>
        <p class="reveal text-center text-[#ebebe6]/50 mb-16">all included. no feature locks.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- smart scheduling -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-6 hover:border-[#f8623a]/40 group">
            <div class="text-[#f8623a] mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <path d="M16 2v4M8 2v4M3 10h18"/>
                <circle cx="12" cy="15" r="2"/>
                <path d="M12 13v-1"/>
              </svg>
            </div>
            <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2 group-hover:text-[#f8623a] transition-colors">smart scheduling</h3>
            <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide mb-4">week strip view. recurring sessions. auto-reminders. no more double-bookings, no more 6am texts asking "are we training today?"</p>
            <div class="outcome-tag text-[10px] text-[#f8623a] tracking-widest">saves ₹600-1,500 per no-show</div>
          </div>

          <!-- payment tracking -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-6 hover:border-[#f8623a]/40 group">
            <div class="text-[#f8623a] mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M9 9h3.5a1.5 1.5 0 0 1 0 3H9v3"/>
                <path d="M9 7.5V9M9 15v1.5"/>
                <path d="M15 9l1 1"/>
              </svg>
            </div>
            <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2 group-hover:text-[#f8623a] transition-colors">payment tracking</h3>
            <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide mb-4">three-tier color reminders: green (paid), yellow (due), red (overdue). full payment history per client. month-end disputes disappear.</p>
            <div class="outcome-tag text-[10px] text-[#f8623a] tracking-widest">no more "i already paid" arguments</div>
          </div>

          <!-- client crm -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-6 hover:border-[#f8623a]/40 group">
            <div class="text-[#f8623a] mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <circle cx="9" cy="11" r="2.5"/>
                <path d="M5 18c0-2 2-3.5 4-3.5s4 1.5 4 3.5"/>
                <path d="M15 9h4M15 13h3"/>
              </svg>
            </div>
            <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2 group-hover:text-[#f8623a] transition-colors">client crm</h3>
            <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide mb-4">structured cards with goals, injuries, vitals, session packages, notes. search, filter, sort. your entire client book, organized.</p>
            <div class="outcome-tag text-[10px] text-[#f8623a] tracking-widest">scale past 20 clients without losing track</div>
          </div>

          <!-- client insights -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-6 hover:border-[#f8623a]/40 group">
            <div class="text-[#f8623a] mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 20V10M12 20V4M6 20v-6"/>
              </svg>
            </div>
            <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2 group-hover:text-[#f8623a] transition-colors">client insights</h3>
            <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide mb-4">per-client analytics. progress over time. export pdf or csv reports. when clients see data, they stay. when they stay, they refer.</p>
            <div class="outcome-tag text-[10px] text-[#f8623a] tracking-widest">data-backed retention and upselling</div>
          </div>

          <!-- ai assistant -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-6 hover:border-[#f8623a]/40 group">
            <div class="text-[#f8623a] mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2 5.5L19.5 9l-5.5 2L12 16.5 10 11 4.5 9l5.5-1.5z"/>
                <path d="M19 16l.5 2 2 .5-2 .5-.5 2-.5-2-2-.5 2-.5z"/>
              </svg>
            </div>
            <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2 group-hover:text-[#f8623a] transition-colors">ai assistant</h3>
            <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide mb-4">generate workouts. get coaching tips. summarize sessions. ask it anything — it responds with context from your client data.</p>
            <div class="outcome-tag text-[10px] text-[#f8623a] tracking-widest">frees 1-2 hrs/day on admin</div>
          </div>

          <!-- qr profile card -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-6 hover:border-[#f8623a]/40 group">
            <div class="text-[#f8623a] mb-4">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="15" y="15" width="3" height="3" rx="0.5"/>
                <path d="M21 15v-1M15 21h-1M21 21h-1v-2M18 21v-1"/>
              </svg>
            </div>
            <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2 group-hover:text-[#f8623a] transition-colors">qr profile card</h3>
            <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide mb-4">a digital card with your name, specializations, rates, and a "book a trial" button. share the qr at gyms, events, or apartment complexes.</p>
            <div class="outcome-tag text-[10px] text-[#f8623a] tracking-widest">your professional identity, shareable</div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── HOW IT WORKS ── -->
    <section id="how" class="py-24 px-6 border-t border-[#ebebe6]/10">
      <div class="max-w-4xl mx-auto">
        <div class="reveal eyebrow text-[#f8623a] mb-4 text-center">how it works</div>
        <h2 class="reveal fluid-h2 font-bold tracking-widest text-center mb-4">
          three steps. one minute each.
        </h2>
        <p class="reveal text-center text-[#ebebe6]/50 mb-16">up and running before your next session</p>

        <div class="flex flex-col md:flex-row gap-8 items-start">
          {[
            {
              step: "1",
              title: "add your clients",
              desc: "import from contacts or add manually. name, number, goals, injuries, package type. takes 30 seconds per client.",
            },
            {
              step: "2",
              title: "schedule the week",
              desc: "drag sessions onto the week strip. set recurring slots. gymbo sends reminders to your clients automatically.",
            },
            {
              step: "3",
              title: "log, track, get paid",
              desc: "after each session, log it with one tap. payment status updates in real time. end of month, everything is already tracked.",
            },
          ].map((s, i) => (
            <div class="reveal flex-1 relative">
              {i < 2 && (
                <div class="hidden md:block absolute top-6 left-full w-8 h-px bg-[#f8623a]/30 top-6"></div>
              )}
              <div class="flex flex-col items-center md:items-start text-center md:text-left">
                <div class="w-12 h-12 rounded-full border-2 border-[#f8623a] flex items-center justify-center font-bold text-[#f8623a] tracking-widest mb-4 text-sm">{s.step}</div>
                <h3 class="font-bold tracking-widest text-[#ebebe6] mb-2">{s.title}</h3>
                <p class="text-[#ebebe6]/60 text-sm leading-relaxed tracking-wide">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── PRICING ── -->
    <section id="pricing" class="py-24 px-6 border-t border-[#ebebe6]/10">
      <div class="max-w-5xl mx-auto">
        <div class="reveal eyebrow text-[#f8623a] mb-4 text-center">pricing</div>
        <h2 class="reveal fluid-h2 font-bold tracking-widest text-center mb-4">
          less than the cost of one missed session.
        </h2>
        <p class="reveal text-center text-[#ebebe6]/50 mb-16">all features included. no ads. no feature locks. cancel anytime.</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">

          <!-- monthly -->
          <div class="reveal feature-card bg-[#242424] border border-[#ebebe6]/10 rounded-2xl p-8 text-center">
            <div class="text-sm text-[#ebebe6]/50 tracking-widest mb-4">flexible</div>
            <div class="text-4xl font-bold text-[#ebebe6] mb-1 counter-price" data-target="400" data-prefix="₹">₹400</div>
            <div class="text-sm text-[#ebebe6]/50 tracking-wide mb-6">/month</div>
            <div class="text-xs text-[#ebebe6]/40 tracking-wide mb-6">pay month to month</div>
