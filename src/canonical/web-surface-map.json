{
  "_comment": "LANDING-OWNED. Where each web-surface canonical string (ids starting site. or trial.) must appear in the BUILT site. mode equals = a whole block equals the string byte for byte; contains = the string is a sentence inside a larger block (the trial line is never a block on its own). A target with `waiver` records a KNOWN DIVERGENCE: the canonical string is absent there and the site carries `observed` instead. A waiver is reported on every run, its observed text must still be present (so it cannot drift further), it fails as STALE if the canonical string appears, and it fails after `expires`. app-side ids (app., cta., finePrint., disclosure., success.) are not this gate's.",
  "map": {
    "trial.line": {
      "targets": [
        {
          "route": "/",
          "surface": "visible block",
          "mode": "contains"
        },
        {
          "route": "/terms/",
          "surface": "visible block",
          "mode": "contains"
        },
        {
          "route": "/pricing.md",
          "surface": "served line",
          "mode": "contains"
        }
      ]
    },
    "trial.eligibilityNote": {
      "targets": [
        {
          "route": "/",
          "surface": "visible block",
          "mode": "contains"
        },
        {
          "route": "/terms/",
          "surface": "visible block",
          "mode": "contains"
        },
        {
          "route": "/pricing.md",
          "surface": "served line",
          "mode": "contains"
        }
      ]
    },
    "trial.comparisonRow": {
      "targets": [
        {
          "route": "/alternatives/akton/",
          "surface": "visible block",
          "mode": "equals"
        },
        {
          "route": "/alternatives/trainerize/",
          "surface": "visible block",
          "mode": "equals"
        },
        {
          "route": "/alternatives/truecoach/",
          "surface": "visible block",
          "mode": "equals"
        },
        {
          "route": "/compare/gymbo-vs-wellnessz/",
          "surface": "visible block",
          "mode": "equals"
        },
        {
          "route": "/blog/best-apps-for-independent-personal-trainers-in-india-2026/",
          "surface": "visible block",
          "mode": "equals"
        }
      ]
